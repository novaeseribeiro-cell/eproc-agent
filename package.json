{
  "name": "eproc-agent",
  "version": "0.5.0",
  "description": "Agente de pré-protocolo no eproc: cadastra a ação e para antes do botão final para o advogado conferir e confirmar.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "teste": "tsc && node teste/conferencia-partes.mjs && node teste/competencia.mjs",
    "login": "tsc && node dist/cli.js login",
    "discover": "tsc && node dist/cli.js discover",
    "catalogo": "tsc && node dist/cli.js catalogo",
    "assuntos": "tsc && node dist/cli.js assuntos",
    "validar": "tsc && node dist/cli.js validar",
    "preparar": "tsc && node dist/cli.js preparar",
    "preparadas": "tsc && node dist/cli.js preparadas",
    "lote:varrer": "tsc && node dist/lote.js varrer",
    "lote:executar": "tsc && node dist/lote.js executar",
    "ler": "pdftotext -layout",
    "assunto:fixar": "tsc && node dist/cli.js assunto:fixar",
    "assunto:listar": "tsc && node dist/cli.js assunto:listar",
    "lote:comarcas": "tsc && node dist/lote.js comarcas"
  },
  "dependencies": {
    "playwright": "^1.47.0",
    "zod": "^3.23.8",
    "pdf-parse": "^1.1.1",
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.5.1"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
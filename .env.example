# Perfil de tribunal (arquivo em tribunais/<id>.json)
TRIBUNAL=tjms
# Diretorio do perfil persistente do navegador (guarda a sessao logada + 2FA validado)
PROFILE_DIR=./.perfil-chromium
# Opcional: webhook (Evolution API, Slack, LEX) avisado quando a acao estiver pronta para conferencia
WEBHOOK_URL=
WEBHOOK_TOKEN=
# Opcional: fila no Supabase (tabela protocolos). Deixe vazio para usar JSON local.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Extracao por IA (modo lote)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Cadencia do lote: segundos entre acoes e maximo por execucao (Res. 383 TJMS, art. 10)
CADENCIA_SEGUNDOS=300
MAX_POR_EXECUCAO=40
